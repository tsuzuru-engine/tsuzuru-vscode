{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tsuzuru",
  "scopeName": "source.tzr",
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#scene-declarations"
    },
    {
      "include": "#choice-options"
    },
    {
      "include": "#builtin-labels"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tzr",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tzr"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tzr"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.tzr",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.tzr",
          "match": "#.*$"
        }
      ]
    },
    "scene-declarations": {
      "patterns": [
        {
          "name": "meta.scene.declaration.tzr",
          "match": "^\\s*(scene)\\s+([A-Za-z_][A-Za-z0-9_.-]*)(\\s*:)",
          "captures": {
            "1": {
              "name": "keyword.declaration.scene.tzr"
            },
            "2": {
              "name": "entity.name.section.scene.tzr"
            },
            "3": {
              "name": "punctuation.separator.colon.tzr"
            }
          }
        }
      ]
    },
    "choice-options": {
      "patterns": [
        {
          "name": "meta.choice.option.tzr",
          "match": "(id)\\s*(=)\\s*([A-Za-z_][A-Za-z0-9_.-]*)(\\s*:)",
          "captures": {
            "1": {
              "name": "storage.modifier.id.tzr"
            },
            "2": {
              "name": "keyword.operator.assignment.tzr"
            },
            "3": {
              "name": "entity.name.label.tzr"
            },
            "4": {
              "name": "punctuation.separator.colon.tzr"
            }
          }
        }
      ]
    },
    "builtin-labels": {
      "patterns": [
        {
          "name": "meta.label.builtin.tzr",
          "match": "^\\s*(narration)(\\s*:)",
          "captures": {
            "1": {
              "name": "support.variable.language.tzr"
            },
            "2": {
              "name": "punctuation.separator.colon.tzr"
            }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "meta.label.line.tzr",
          "match": "^\\s*(?!(?:title|character|include|scene|choice|if|elif|else|jump|end|bg|show|hide|clear|wait|voice|stopBgm|set|add|narration)\\b)([A-Za-z_][A-Za-z0-9_.-]*)(\\s*:)",
          "captures": {
            "1": {
              "name": "entity.name.label.tzr"
            },
            "2": {
              "name": "punctuation.separator.colon.tzr"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.tzr",
          "match": "\\b(title|character|include|scene)\\b"
        },
        {
          "name": "keyword.control.tzr",
          "match": "\\b(choice|if|elif|else|jump|end)\\b"
        },
        {
          "name": "support.function.command.visual-audio.tzr",
          "match": "\\b(bg|show|hide|clear|wait|voice|stopBgm)\\b"
        },
        {
          "name": "support.function.command.state.tzr",
          "match": "\\b(set|add)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.tzr",
          "match": "\\b(with|at|id|name)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.variable.language.tzr",
          "match": "\\b(narration|scenario|system)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tzr",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.tzr",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.assignment.tzr",
          "match": "\\+=|="
        }
      ]
    }
  }
}
