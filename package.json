{
  "name": "tsuzuru-vscode",
  "displayName": "Tsuzuru",
  "description": "Language support for Tsuzuru scenario files.",
  "version": "0.0.2",
  "publisher": "tsuzuru",
  "license": "MIT",
  "packageManager": "pnpm@11.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsuzuru-engine/tsuzuru-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/tsuzuru-engine/tsuzuru-vscode/issues"
  },
  "homepage": "https://github.com/tsuzuru-engine/tsuzuru-vscode#readme",
  "keywords": [
    "tsuzuru",
    "tzr",
    "visual novel",
    "novel game",
    "syntax highlighting"
  ],
  "categories": ["Programming Languages"],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": ["onLanguage:tzr"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tzr",
        "aliases": ["Tsuzuru", "tzr"],
        "extensions": [".tzr"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tzr",
        "scopeName": "source.tzr",
        "path": "./syntaxes/tzr.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "typecheck": "tsc --noEmit -p .",
    "package": "pnpm compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.3.3"
  }
}
